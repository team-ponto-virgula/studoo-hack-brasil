{
  "expo": {
    "name": "Studoo",
    "slug": "studoo-mobile",
    "version": "0.1.0",
    "scheme": "studoo-dev",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/marca/icone-1024.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-android-piloto-ca.cjs",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que o Studoo grave sua explicação para transcrever e revisar?"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir que o Studoo fotografe seu material de estudo?",
          "photosPermission": "Permitir que o Studoo selecione uma foto do seu material?",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.studoo.mobile.dev"
    },
    "ios": {
      "bundleIdentifier": "com.studoo.mobile.dev"
    }
  }
}
