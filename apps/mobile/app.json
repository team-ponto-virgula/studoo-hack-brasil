{
  "expo": {
    "name": "Studoo",
    "slug": "studoo-mobile",
    "version": "0.1.0",
    "scheme": "studoo-dev",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/marca/icone-1024.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "./plugins/with-android-piloto-ca.cjs",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "O Studoo usa o microfone para gravar a sua explicação em voz alta, transcrever e revisar o que você disse.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Studoo usa a câmera para fotografar o seu material de estudo e a foto do perfil ou da capa da trilha.",
          "photosPermission": "O Studoo usa as suas fotos para escolher o material de estudo e a foto do perfil ou da capa da trilha.",
          "microphonePermission": "O Studoo usa o microfone para gravar a sua explicação em voz alta, transcrever e revisar o que você disse."
        }
      ],
      "expo-image",
      "expo-asset"
    ],
    "android": {
      "package": "com.studoo.mobile.dev"
    },
    "ios": {
      "bundleIdentifier": "com.studoo.mobile.dev",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/marca/icone-ios-1024.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "81f67b49-67e1-4807-bf88-16f187169dfd"
      }
    },
    "owner": "studoo"
  }
}
