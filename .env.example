DATABASE_URL=
STUDOO_ORIGEM=http://localhost:3000
STUDOO_DOMINIO_EMAIL=example.test
STUDOO_EMAIL=piloto@example.test
STUDOO_SENHA=
STUDOO_CHAVE_ASSINATURA=
STUDOO_SESSAO_MOBILE_PILOTO=0
IA=falsa
EMAIL=falso
# Opcionais: pausa entre eventos da IA falsa (ms; 0 nos testes) e teto provisório de gerações por pessoa (D7 aberta).
# STUDOO_IA_FALSA_PAUSA_MS=450
# STUDOO_LIMITE_GERACOES=20
# STUDOO_JANELA_GERACOES_MIN=60
# IA da OpenAI: o db:local exige IA=falsa aqui; ponha estas linhas num .env.local (docs/RODAR-LOCALMENTE.md#ia-da-openai).
# IA=openai
# OPENAI_API_KEY=
# OPENAI_MODELO=gpt-4.1
# OPENAI_ESFORCO=low
#
# IA da DeepSeek: alternativa por flag (docs/RODAR-LOCALMENTE.md#ia-da-deepseek).
# IA=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODELO=deepseek-flash
# DEEPSEEK_RACIOCINIO=false
# Modo misto (o do site): texto pela DeepSeek e voz pela OpenAI. Com IA=deepseek, ponha também OPENAI_API_KEY:
# a conversa ao vivo e a transcrição da gravação usam a OpenAI; trilhas, material, ponte e o retorno da explicação
# continuam na DeepSeek, e nenhum texto vai para a OpenAI. Sem OPENAI_API_KEY, a voz e a gravação ficam indisponíveis.
#
# Lições escritas ao mesmo tempo no aceite de uma trilha (1 a 10; padrão 10, todas juntas). Contas com limite baixo
# por minuto (como a OpenAI com 10 mil tokens/min) usam 1 ou 2; a DeepSeek aguenta o padrão.
# STUDOO_GERACAO_PARALELA=10
#
# STUDOO_IA_RESERVA=falsa

# Login Google (cliente OAuth do tipo Aplicativo da Web no Google Cloud).
# URI de redirecionamento autorizada: ${STUDOO_ORIGEM}/api/auth/google/retorno
# Mesmo cliente é usado pelo servidor para web e app; nunca exponha o secret no Expo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Retorno fixo ao app após o callback HTTPS. Deve combinar com o scheme do app.json.
STUDOO_GOOGLE_MOBILE_REDIRECT_URI=studoo-dev://auth/google
# STUDOO_DOMINIO_EMAIL limita TODOS os logins ao domínio informado.
# Em produção aberta (Gmail/Google Workspace etc.), deixe STUDOO_DOMINIO_EMAIL vazio.
# STUDOO_EMAILS_PERMITIDOS libera, além do domínio, e-mails exatos (separados por vírgula, até 20; maiúsculas e
# espaços não importam). Vale para senha, recuperação e Google. Não abre o domínio desses e-mails. Ex.:
# STUDOO_EMAILS_PERMITIDOS=pessoa@exemplo.com,outra.pessoa@exemplo.org
# Para habilitar o app: STUDOO_SESSAO_MOBILE_PILOTO=1 e STUDOO_ORIGEM em HTTPS.
# Atrás de proxy reverso HTTPS confiável (ex.: Traefik/Dokploy), defina STUDOO_PROXY_HTTPS=1.
# STUDOO_PROXY_HTTPS=0
# Visitante sem conta (desligado por padrão; 1 habilita "Experimentar sem conta" por 24 h)
# Atrás de proxy reverso, exige STUDOO_PROXY_HTTPS=1 para limitar por IP real em vez de um único balde global.
STUDOO_VISITANTE=0
# STUDOO_LIMITE_VISITANTES_IP=20
# STUDOO_JANELA_VISITANTES_MIN=15
# STUDOO_LIMITE_VISITANTES_GLOBAL=120
# STUDOO_LIMITE_GERACOES_VISITANTE=3
# STUDOO_LIMITE_GERACOES_VISITANTES_DIA=60

# Página de apresentação do Studoo (spec 18). "/conheca" e "/baixar" ficam sempre no ar. STUDOO_ENTRADA_APRESENTACAO (desligada por padrão; lida a cada pedido, sem rebuild):
# 1 mostra a página em "/" a quem não tem sessão; sem a variável, ou com outro valor, "/" sem sessão leva ao /login. Com sessão (visitante incluído), "/" abre o app nos dois casos.
STUDOO_ENTRADA_APRESENTACAO=0
# O QR e o botão "Baixar para Android" usam STUDOO_ORIGEM (HTTPS público) e STUDOO_APK_URL (padrão: o APK do build 4). Com STUDOO_TESTFLIGHT_URL (link público) o iPhone instala pelo TestFlight;
# vazia, a página diz que o app para iPhone chega em breve e mostra como pôr o Studoo na Tela de Início.
# STUDOO_APK_URL=
# STUDOO_TESTFLIGHT_URL=

# Recuperação de senha: EMAIL=resend em produção.
# EMAIL=falso salva mensagens em .studoo-local/emails/, SOMENTE em origem loopback.
# Códigos expiram em 15 minutos; não são retornados pela API nem escritos nos logs.
# Chave somente no servidor; nunca use EXPO_PUBLIC_ ou NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM=
# Use um domínio verificado no Resend. Exemplo de remetente: Studoo <acesso@seu-dominio.com>

# Criar conta por e-mail (desligado por padrão). Usa o mesmo envio de e-mail acima: sem ele, o cadastro fica desligado.
# Código de 6 dígitos (15 min, uso único, 5 tentativas). Limites: 3 códigos por e-mail e 10 por rede a cada 15 min,
# 200 por hora no total. Respeita STUDOO_DOMINIO_EMAIL / STUDOO_EMAILS_PERMITIDOS. Ver docs/ACESSO-APPLE-CADASTRO.md.
STUDOO_CADASTRO=0

# Iniciar sessão com a Apple no iPhone (desligado por padrão). Exige também STUDOO_SESSAO_MOBILE_PILOTO=1 e origem HTTPS.
# Chave .p8 só no servidor (nunca EXPO_PUBLIC_/NEXT_PUBLIC_), em PEM com quebras como \n. APPLE_BUNDLE_IDS: bundles do
# app aceitos no token, separados por vírgula. Ver docs/ACESSO-APPLE-CADASTRO.md.
STUDOO_APPLE=0
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_IDS=

# Material com referências, reforço e Ensine ao Stu (IA=openai)
OPENAI_MODELO_ESTUDIO=gpt-4.1
# Transcrição de áudio (sempre pela OpenAI, também no modo misto com IA=deepseek); até 60 s na interface e 5 MB no servidor
OPENAI_MODELO_TRANSCRICAO=gpt-transcribe

# Perfis e compartilhar trilha (spec 09; desligado por padrão). Com 1: perfil leve, link de trilha (/t/<código>),
# página pública do perfil (/p/<id>) e "Adicionar por link". Sem a flag, nenhuma tela, rota ou item novo aparece.
# As rotas públicas (prévia do link e perfil) contam 120 aberturas por 15 min por endereço só com STUDOO_PROXY_HTTPS=1
# (endereço confiável); sem ele, um disjuntor global de 3.000 por 15 min vale para todos juntos.
STUDOO_COMPARTILHAR=0

# Voz ao vivo com o Stu (desligada por padrão). Exige OPENAI_API_KEY (a conversa é da OpenAI) e texto real configurado:
# IA=openai, ou IA=deepseek com DEEPSEEK_API_KEY (modo misto: o texto da conversa é avaliado pela DeepSeek).
# Com IA=falsa, fica desligada.
STUDOO_VOZ_AO_VIVO=0
# STUDOO_VOZ_AO_VIVO_VISITANTE=0
# OPENAI_REALTIME_MODELO=gpt-realtime-2.1
# OPENAI_REALTIME_VOZ=marin
# STUDOO_LIMITE_VOZ_HORA=3
# STUDOO_LIMITE_VOZ_DIA=10
# STUDOO_LIMITE_VOZ_VISITANTE=1
# STUDOO_LIMITE_VOZ_VISITANTES_DIA=20
