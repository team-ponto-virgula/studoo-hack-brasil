DATABASE_URL=
STUDOO_ORIGEM=http://localhost:3000
STUDOO_DOMINIO_EMAIL=example.test
STUDOO_EMAIL=piloto@example.test
STUDOO_SENHA=
STUDOO_CHAVE_ASSINATURA=
STUDOO_SESSAO_MOBILE_PILOTO=0
IA=falsa
EMAIL=falso
# Opcionais: pausa entre eventos da IA falsa (ms; 0 nos testes) e teto provisório de gerações por pessoa (D7 aberta).
# STUDOO_IA_FALSA_PAUSA_MS=450
# STUDOO_LIMITE_GERACOES=20
# STUDOO_JANELA_GERACOES_MIN=60
# IA da OpenAI: o db:local exige IA=falsa aqui; ponha estas linhas num .env.local (docs/RODAR-LOCALMENTE.md#ia-da-openai).
# IA=openai
# OPENAI_API_KEY=
# OPENAI_MODELO=gpt-5.6-luna
# OPENAI_ESFORCO=low
# STUDOO_IA_RESERVA=falsa

# Login Google (cliente OAuth do tipo Aplicativo da Web no Google Cloud).
# URI de redirecionamento autorizada: ${STUDOO_ORIGEM}/api/auth/google/retorno
# Mesmo cliente é usado pelo servidor para web e app; nunca exponha o secret no Expo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Retorno fixo ao app após o callback HTTPS. Deve combinar com o scheme do app.json.
STUDOO_GOOGLE_MOBILE_REDIRECT_URI=studoo-dev://auth/google
# STUDOO_DOMINIO_EMAIL limita TODOS os logins ao domínio informado.
# Em produção aberta (Gmail/Google Workspace etc.), deixe STUDOO_DOMINIO_EMAIL vazio.
# Para habilitar o app: STUDOO_SESSAO_MOBILE_PILOTO=1 e STUDOO_ORIGEM em HTTPS.

# Recuperação de senha: EMAIL=smtp em produção.
# EMAIL=falso salva mensagens em .studoo-local/emails/, SOMENTE em origem loopback.
# Códigos expiram em 15 minutos; não são retornados pela API nem escritos nos logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Exemplo de remetente: Studoo <acesso@seu-dominio.com>
