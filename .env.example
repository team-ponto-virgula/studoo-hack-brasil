DATABASE_URL=
STUDOO_ORIGEM=http://localhost:3000
STUDOO_DOMINIO_EMAIL=example.test
STUDOO_EMAIL=piloto@example.test
STUDOO_SENHA=
STUDOO_CHAVE_ASSINATURA=
STUDOO_SESSAO_MOBILE_PILOTO=0
IA=falsa
EMAIL=falso
# Opcionais: pausa entre eventos da IA falsa (ms; 0 nos testes) e teto provisório de gerações por pessoa (D7 aberta).
# STUDOO_IA_FALSA_PAUSA_MS=450
# STUDOO_LIMITE_GERACOES=20
# STUDOO_JANELA_GERACOES_MIN=60
# IA da OpenAI: o db:local exige IA=falsa aqui; ponha estas linhas num .env.local (docs/RODAR-LOCALMENTE.md#ia-da-openai).
# IA=openai
# OPENAI_API_KEY=
# OPENAI_MODELO=gpt-4.1
# OPENAI_ESFORCO=low
#
# IA da DeepSeek: alternativa por flag (docs/RODAR-LOCALMENTE.md#ia-da-deepseek).
# IA=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODELO=deepseek-flash
# DEEPSEEK_RACIOCINIO=false
#
# STUDOO_IA_RESERVA=falsa

# Login Google (cliente OAuth do tipo Aplicativo da Web no Google Cloud).
# URI de redirecionamento autorizada: ${STUDOO_ORIGEM}/api/auth/google/retorno
# Mesmo cliente é usado pelo servidor para web e app; nunca exponha o secret no Expo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Retorno fixo ao app após o callback HTTPS. Deve combinar com o scheme do app.json.
STUDOO_GOOGLE_MOBILE_REDIRECT_URI=studoo-dev://auth/google
# STUDOO_DOMINIO_EMAIL limita TODOS os logins ao domínio informado.
# Em produção aberta (Gmail/Google Workspace etc.), deixe STUDOO_DOMINIO_EMAIL vazio.
# Para habilitar o app: STUDOO_SESSAO_MOBILE_PILOTO=1 e STUDOO_ORIGEM em HTTPS.
# Atrás de proxy reverso HTTPS confiável (ex.: Traefik/Dokploy), defina STUDOO_PROXY_HTTPS=1.
# STUDOO_PROXY_HTTPS=0
# Visitante sem conta (desligado por padrão; 1 habilita "Experimentar sem conta" por 24 h)
# Atrás de proxy reverso, exige STUDOO_PROXY_HTTPS=1 para limitar por IP real em vez de um único balde global.
STUDOO_VISITANTE=0
# STUDOO_LIMITE_VISITANTES_IP=20
# STUDOO_JANELA_VISITANTES_MIN=15
# STUDOO_LIMITE_VISITANTES_GLOBAL=120
# STUDOO_LIMITE_GERACOES_VISITANTE=3
# STUDOO_LIMITE_GERACOES_VISITANTES_DIA=60

# Recuperação de senha: EMAIL=resend em produção.
# EMAIL=falso salva mensagens em .studoo-local/emails/, SOMENTE em origem loopback.
# Códigos expiram em 15 minutos; não são retornados pela API nem escritos nos logs.
# Chave somente no servidor; nunca use EXPO_PUBLIC_ ou NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM=
# Use um domínio verificado no Resend. Exemplo de remetente: Studoo <acesso@seu-dominio.com>

# Material com referências, reforço e Ensine ao Stu (IA=openai)
OPENAI_MODELO_ESTUDIO=gpt-4.1
# Transcrição de áudio; até 60 s na interface e 5 MB no servidor
OPENAI_MODELO_TRANSCRICAO=gpt-transcribe

# Voz ao vivo com o Stu (desligada por padrão; exige IA=openai e OPENAI_API_KEY)
STUDOO_VOZ_AO_VIVO=0
# STUDOO_VOZ_AO_VIVO_VISITANTE=0
# OPENAI_REALTIME_MODELO=gpt-realtime-2.1
# OPENAI_REALTIME_VOZ=marin
# STUDOO_LIMITE_VOZ_HORA=3
# STUDOO_LIMITE_VOZ_DIA=10
# STUDOO_LIMITE_VOZ_VISITANTE=1
# STUDOO_LIMITE_VOZ_VISITANTES_DIA=20
