{
  "name": "studoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "next dev --hostname localhost",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "start": "next start --hostname localhost",
    "pretypecheck": "npm run db:generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test:marco": "node --env-file=.env --test tests/marco-local.test.mjs",
    "test:dominio": "node --env-file=.env --import tsx --test tests/dominio-geracao.test.mjs",
    "test:trilha": "node --env-file=.env --import tsx --test tests/trilha-ao-vivo.test.mjs",
    "test:mobile": "node --env-file=.env --test tests/marco-mobile-local.test.mjs",
    "test:movimento": "node --test tests/movimento-mobile.test.mjs",
    "test:paridade": "node --test tests/paridade-mundo.test.mjs",
    "test:google-mobile": "node --test tests/google-mobile.test.mjs",
    "test:acesso": "node --env-file=.env --import tsx --test tests/acesso-google-recuperacao.test.mjs",
    "test:ia": "node --import tsx --test tests/ia-openai.test.mjs",
    "ia:conferir": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/conferir-openai.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:local": "node scripts/banco-local.mjs",
    "test:email": "node --import tsx --test tests/email-resend.test.mjs",
    "test:estudio": "node --env-file=.env --import tsx --test tests/estudio.test.mjs",
    "estudio:limpar": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/limpar-materiais.ts",
    "test:estudio:interface": "node --test tests/estudio-interface.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@studoo/contratos": "0.1.0",
    "dotenv": "^17.0.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.17",
    "mammoth": "^1.13.0",
    "next": "^16.1.0",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.6.0-beta.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
