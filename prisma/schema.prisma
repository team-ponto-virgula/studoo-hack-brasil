generator client {
  provider            = "prisma-client"
  output              = "../src/servidor/banco/gerado"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum CanalSessao {
  WEB
  MOBILE
}

model Usuario {
  id        String             @id @default(uuid())
  email     String             @unique
  senhaHash String?
  googleSub String? @unique
  recuperacao RecuperacaoSenha?
  codigosMobile CodigoGoogleMobile[]
  fuso      String
  sessoes   Sessao[]
  planos    PlanoAprendizado[]
  materiais MaterialEstudo[]
}

model Sessao {
  tokenHash String      @id
  usuarioId String
  canal     CanalSessao @default(WEB)
  criadaEm  DateTime    @default(now()) @db.Timestamptz(3)
  expiraEm  DateTime    @db.Timestamptz(3)
  usuario   Usuario     @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model TentativaLogin {
  chave        String   @id
  falhas       Int
  janelaInicio DateTime @db.Timestamptz(3)
}

model PlanoAprendizado {
  usuarioId String
  id        String
  titulo    String
  objetivo  String
  origem    String
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  fluxos    Fluxo[]

  @@id([usuarioId, id])
}

model Fluxo {
  usuarioId String
  id        String
  planoId   String
  titulo    String
  ordem     Int
  plano     PlanoAprendizado @relation(fields: [usuarioId, planoId], references: [usuarioId, id])
  licoes    Licao[]

  @@id([usuarioId, id])
  @@unique([usuarioId, planoId, ordem])
}

model Licao {
  usuarioId String
  id        String
  fluxoId   String
  titulo    String
  ordem     Int
  conteudo  Json
  fluxo     Fluxo           @relation(fields: [usuarioId, fluxoId], references: [usuarioId, id])
  conclusao RegistroEstudo?
  apoio ApoioLicao?

  @@id([usuarioId, id])
  @@unique([usuarioId, fluxoId, ordem])
}

model RegistroEstudo {
  usuarioId   String
  licaoId     String
  concluidoEm DateTime @default(now()) @db.Timestamptz(3)
  licao       Licao    @relation(fields: [usuarioId, licaoId], references: [usuarioId, id])

  @@id([usuarioId, licaoId])
}

// Estado curto da autorização; o cookie vincula o retorno ao navegador que iniciou.
model AutorizacaoGoogle {
  estadoHash String @id
  navegadorHash String
  nonce String
  verificador String
  desafioMobile String?
  expiraEm DateTime @db.Timestamptz(3)
  @@index([expiraEm])
}

// Apenas um código de troca, nunca uma sessão, é enviado pelo deep link ao app.
model CodigoGoogleMobile {
  codigoHash String @id
  usuarioId String
  desafio String
  expiraEm DateTime @db.Timestamptz(3)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([expiraEm])
}

model RecuperacaoSenha {
  usuarioId String @id
  codigoHash String
  expiraEm DateTime @db.Timestamptz(3)
  tentativas Int @default(0)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model MaterialEstudo {
  usuarioId String
  id String @default(uuid())
  nome String
  paginas Json
  leitura String
  rascunho Json?
  expiraEm DateTime @db.Timestamptz(3)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@id([usuarioId, id])
  @@index([expiraEm])
}

model ApoioLicao {
  usuarioId String
  licaoId String
  erros Int @default(0)
  ultimaResposta String?
  reforco Json?
  reforcoConcluido Boolean @default(false)
  ensino Json?
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)
  licao Licao @relation(fields: [usuarioId, licaoId], references: [usuarioId, id], onDelete: Cascade)
  @@id([usuarioId, licaoId])
}
