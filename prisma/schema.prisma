generator client {
  provider            = "prisma-client"
  output              = "../src/servidor/banco/gerado"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum CanalSessao {
  WEB
  MOBILE
}

model Usuario {
  id        String             @id @default(uuid())
  email     String             @unique
  senhaHash String?
  googleSub String? @unique
  recuperacao RecuperacaoSenha?
  codigosMobile CodigoGoogleMobile[]
  fuso      String
  sessoes   Sessao[]
  planos    PlanoAprendizado[]
  materiais MaterialEstudo[]
  /// Perfil leve (spec 09): nome e cor do avatar; o id público (aleatório) é o da página /p/<id>.
  perfilNome String?
  perfilCor  String?
  perfilId   String? @unique
  /// Perfil rico (spec 10): resumo (até 160) e interesses (até 5 temas de TEMAS).
  perfilResumo     String?
  perfilInteresses String[] @default([])
  foto             FotoPerfil?
  eventos          EventoTrilha[]
  denuncias        Denuncia[]
}

/// Foto do perfil (spec 10), já recortada e regravada em WebP (sem EXIF). O token aleatório é o endereço público e muda a
/// cada troca; remover a foto apaga a linha.
model FotoPerfil {
  usuarioId String   @id
  token     String   @unique
  grande    Bytes
  pequena   Bytes
  criadaEm  DateTime @default(now()) @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Sessao {
  tokenHash String      @id
  usuarioId String
  canal     CanalSessao @default(WEB)
  criadaEm  DateTime    @default(now()) @db.Timestamptz(3)
  expiraEm  DateTime    @db.Timestamptz(3)
  usuario   Usuario     @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model TentativaLogin {
  chave        String   @id
  falhas       Int
  janelaInicio DateTime @db.Timestamptz(3)
}

model PlanoAprendizado {
  usuarioId String
  id        String
  titulo    String
  objetivo  String
  origem    String
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  fluxos    Fluxo[]
  /// Trilha recebida por link: nome e id público de quem compartilhou (no momento da cópia) e o código do link.
  origemNome     String?
  origemPerfilId String?
  origemCodigo   String?
  links          LinkTrilha[]

  @@id([usuarioId, id])
  @@unique([usuarioId, origemCodigo])
}

/// Link de compartilhamento de uma trilha (um por trilha). Encerrar apaga a linha; apagar a trilha apaga o link.
model LinkTrilha {
  codigo      String           @id
  usuarioId   String
  planoId     String
  noPerfil    Boolean          @default(false)
  adicoes     Int              @default(0)
  criadoEm    DateTime         @default(now()) @db.Timestamptz(3)
  /// Comunidade (spec 10, etapa B): publicada no Explorar (também aparece no perfil), com tema e legenda.
  noExplorar  Boolean          @default(false)
  tema        String?
  legenda     String?
  publicadaEm DateTime?        @db.Timestamptz(3)
  /// Três contas distintas denunciaram: sai do Explorar até revisão.
  oculta      Boolean          @default(false)
  plano       PlanoAprendizado @relation(fields: [usuarioId, planoId], references: [usuarioId, id], onDelete: Cascade)
  eventos     EventoTrilha[]

  @@unique([usuarioId, planoId])
  @@index([usuarioId, noPerfil])
  @@index([noExplorar, oculta, publicadaEm(sort: Desc), codigo(sort: Desc)])
}

/// Adição ("Quero estudar") e valeu, com data: um por conta por trilha. O "Em alta" soma os dos últimos 7 dias.
/// Contas de visitante não geram evento. Desligar o valeu apaga a linha.
model EventoTrilha {
  codigo    String
  usuarioId String
  tipo      String
  criadoEm  DateTime   @default(now()) @db.Timestamptz(3)
  link      LinkTrilha @relation(fields: [codigo], references: [codigo], onDelete: Cascade)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([codigo, usuarioId, tipo])
  @@index([tipo, criadoEm])
  @@index([usuarioId, tipo])
}

/// Denúncia de trilha (código do link) ou perfil (id público), uma por conta por alvo. Sem painel: banco e log.
model Denuncia {
  id        String   @id @default(uuid())
  alvoTipo  String
  alvo      String
  usuarioId String
  motivo    String
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([alvoTipo, alvo, usuarioId])
}

model Fluxo {
  usuarioId String
  id        String
  planoId   String
  titulo    String
  ordem     Int
  plano     PlanoAprendizado @relation(fields: [usuarioId, planoId], references: [usuarioId, id])
  licoes    Licao[]

  @@id([usuarioId, id])
  @@unique([usuarioId, planoId, ordem])
}

model Licao {
  usuarioId String
  id        String
  fluxoId   String
  titulo    String
  ordem     Int
  conteudo  Json
  fluxo     Fluxo           @relation(fields: [usuarioId, fluxoId], references: [usuarioId, id])
  conclusao RegistroEstudo?
  apoio ApoioLicao?

  @@id([usuarioId, id])
  @@unique([usuarioId, fluxoId, ordem])
}

model RegistroEstudo {
  usuarioId   String
  licaoId     String
  concluidoEm DateTime @default(now()) @db.Timestamptz(3)
  /// Como foi a prática no mundo real (consegui, quase, ainda_nao), quando a lição tem uma.
  pratica     String?
  /// O resumo da lição: quanto tempo levou e quantos exercícios saíram de primeira (o fim da trilha soma).
  segundos          Int?
  acertosDePrimeira Int?
  exercicios        Int?
  licao       Licao    @relation(fields: [usuarioId, licaoId], references: [usuarioId, id])

  @@id([usuarioId, licaoId])
}

// Estado curto da autorização; o cookie vincula o retorno ao navegador que iniciou.
model AutorizacaoGoogle {
  estadoHash String @id
  navegadorHash String
  nonce String
  verificador String
  desafioMobile String?
  expiraEm DateTime @db.Timestamptz(3)
  @@index([expiraEm])
}

// Apenas um código de troca, nunca uma sessão, é enviado pelo deep link ao app.
model CodigoGoogleMobile {
  codigoHash String @id
  usuarioId String
  desafio String
  expiraEm DateTime @db.Timestamptz(3)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([expiraEm])
}

model RecuperacaoSenha {
  usuarioId String @id
  codigoHash String
  expiraEm DateTime @db.Timestamptz(3)
  tentativas Int @default(0)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model MaterialEstudo {
  usuarioId String
  id String @default(uuid())
  nome String
  paginas Json
  leitura String
  rascunho Json?
  expiraEm DateTime @db.Timestamptz(3)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@id([usuarioId, id])
  @@index([expiraEm])
}

model ApoioLicao {
  usuarioId String
  licaoId String
  erros Int @default(0)
  ultimaResposta String?
  /// O exercício (0 é o principal) de onde veio o último erro.
  ultimoIndice Int?
  reforco Json?
  reforcoConcluido Boolean @default(false)
  ensino Json?
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)
  licao Licao @relation(fields: [usuarioId, licaoId], references: [usuarioId, id], onDelete: Cascade)
  @@id([usuarioId, licaoId])
}
